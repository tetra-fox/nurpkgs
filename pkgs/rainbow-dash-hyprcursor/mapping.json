{
  "Dash -Normal Select-.ani": {
    "shape": "default",
    "overrides": ["left_ptr", "arrow", "top_left_arrow"]
  },
  "Dash -Help Select-.ani": {
    "shape": "help",
    "overrides": ["left_ptr_help", "question_arrow", "whats_this"]
  },
  "Dash -Working in Backround-.ani": {
    "shape": "progress",
    "overrides": ["left_ptr_watch", "half-busy"]
  },
  "Dash -Busy-.ani": {
    "shape": "wait",
    "overrides": ["watch"]
  },
  "Dash -Precision Select-.ani": {
    "shape": "crosshair",
    "overrides": ["cross", "tcross"]
  },
  "Dash -Text Select-.ani": {
    "shape": "text",
    "overrides": ["xterm", "ibeam"]
  },
  "Dash -Handwriting-.ani": {
    "shape": "pencil",
    "overrides": ["draft"]
  },
  "Dash -Unavailable-.ani": {
    "shape": "not-allowed",
    "overrides": ["forbidden", "crossed_circle"]
  },
  "Dash -Vertical-.ani": {
    "shape": "ns-resize",
    "overrides": ["n-resize", "s-resize", "size_ver", "sb_v_double_arrow", "v_double_arrow", "double_arrow", "row-resize"]
  },
  "Dash -Horizontal-.ani": {
    "shape": "ew-resize",
    "overrides": ["e-resize", "w-resize", "size_hor", "sb_h_double_arrow", "h_double_arrow", "col-resize"]
  },
  "Dash -Diagonal 1-.ani": {
    "shape": "nwse-resize",
    "overrides": ["nw-resize", "se-resize", "size_fdiag", "bd_double_arrow", "top_left_corner", "bottom_right_corner"]
  },
  "Dash -Diagonal 2-.ani": {
    "shape": "nesw-resize",
    "overrides": ["ne-resize", "sw-resize", "size_bdiag", "fd_double_arrow", "top_right_corner", "bottom_left_corner"]
  },
  "Dash -Move-.ani": {
    "shape": "move",
    "overrides": ["all-scroll", "fleur", "size_all", "grabbing", "closedhand"]
  },
  "Dash -Alternate Select-.ani": {
    "shape": "context-menu",
    "overrides": ["right_ptr"]
  },
  "Dash -Link Select-.ani": {
    "shape": "pointer",
    "overrides": ["hand", "hand1", "hand2", "pointing_hand"]
  }
}

--- a/scripts/setup-prefix.sh
+++ b/scripts/setup-prefix.sh
@@ -684,7 +684,12 @@
     fi
     if [ -d "$root/vendor/winetricks-cache" ]; then
         tmpc="$(mktemp -d)"
-        ln -s "$root/vendor/winetricks-cache" "$tmpc/winetricks"
+        # the vendored cache lives in the read-only nix store; keep the cache
+        # root writable so winetricks can still download unvendored verbs (mfc42)
+        mkdir "$tmpc/winetricks"
+        for d in "$root/vendor/winetricks-cache"/*; do
+            ln -s "$d" "$tmpc/winetricks/${d##*/}"
+        done
         export XDG_CACHE_HOME="$tmpc"
         echo "   using bundled winetricks cache ($root/vendor/winetricks-cache)"
     fi
@@ -1034,6 +1039,11 @@
   wine reg add 'HKCU\Software\Wine\X11 Driver' \
     /v FileDialogPortal /t REG_SZ /d auto /f
 fi
+# nixpkgs wine ships ffmpeg (winedmo), not winegstreamer; mfsrcsnk only uses
+# its own winedmo sources when the gst byte stream handler is disabled. without
+# this, live cannot import mp3/aac/m4a
+# (MFCreateSourceReaderFromURL fails with MF_E_UNSUPPORTED_BYTESTREAM_TYPE)
+wine reg add 'HKCU\Software\Wine\MediaFoundation' /v DisableGstByteStreamHandler /t REG_DWORD /d 1 /f
 push2_key='HKCU\Software\Wine\AppDefaults\Push2DisplayProcess.exe\DllOverrides'
 wine reg add "$push2_key" /v libusb-1.0 /t REG_SZ /d builtin /f
 wine reg query "$push2_key" /v libusb-1.0
